# Modele de configuration d'authentification (comptes de l'equipe OPO).
#
# Ce fichier .exemple est le seul suivi par Git (meme principe que
# .env.exemple pour la cle du modele) : il ne contient que des valeurs
# factices, jamais de vrais mots de passe. Pour un usage LOCAL uniquement :
#   copie auth_config.yaml.exemple en auth_config.yaml (meme dossier),
#   remplace les comptes/mots de passe ci-dessous par les vrais, puis
#   change la cle sous "cookie". auth_config.yaml est deja dans .gitignore
#   et ne sera jamais envoye sur GitHub.
#
# Pour un vrai deploiement (Streamlit Community Cloud), utilisez plutot le
# gestionnaire de secrets de la plateforme (Settings -> Secrets de l'appli),
# lu en priorite par auth.py - ce fichier local ne sert alors que de repli
# pour le developpement, au format TOML suivant :
#
#   [auth.usernames.admin]
#   name = "Administrateur OPO"
#   email = "admin@opo.example.org"
#   password = "un_vrai_mot_de_passe"
#   role = "correction"
#
#   [auth.cookie]
#   name = "opo_auth_cookie"
#   key = "une_cle_aleatoire_secrete"      # ex: python -c "import secrets; print(secrets.token_hex(32))"
#   expiry_days = 7
#
# role : "correction" (acces complet, y compris revue des incoherences a valider)
#        ou "consultation" (indicateurs, echantillons, syntaxes uniquement —
#        role enregistre mais pas encore utilise pour restreindre l'interface :
#        toute personne connectee voit actuellement les memes fonctionnalites).

credentials:
  usernames:
    admin:
      name: "Administrateur OPO"
      email: "admin@opo.example.org"
      password: "ChangezMoi123!"
      role: "correction"
    analyste1:
      name: "Analyste OPO"
      email: "analyste1@opo.example.org"
      password: "ChangezMoiAussi123!"
      role: "consultation"

cookie:
  name: "opo_auth_cookie"
  key: "REMPLACER_PAR_UNE_CLE_SECRETE_ALEATOIRE"
  expiry_days: 7
